{
  "name": "floating-todo",
  "productName": "FloatingTodo",
  "version": "0.1.8",
  "description": "桌面悬浮待办 - 一颗五彩球，点开就是待办清单",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File assets/make-icons.ps1 && node scripts/make-ico.js",
    "sound": "node scripts/make-sound.js",
    "test": "node scripts/test-ingest.js && node scripts/test-userscript-logic.js",
    "test:parser": "node scripts/test-parser.js",
    "test:ingest": "node scripts/test-ingest.js",
    "test:userscript": "node scripts/test-userscript-logic.js",
    "test:collector": "electron scripts/test-collector.js",
    "make:bookmarklet": "node scripts/make-bookmarklet.js",
    "pack": "node scripts/pack.js"
  },
  "author": "Leo Zhu",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0"
  }
}
